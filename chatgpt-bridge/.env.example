# Network
BRIDGE_BIND_ADDRESS=127.0.0.1
BRIDGE_PORT=8001

# HTTP Bearer authentication.
# Set a strong random secret when the server is reachable by another machine
# or Docker network.
BRIDGE_API_KEY=

# WebSocket pairing token used by the Chrome extension.
BRIDGE_WS_TOKEN=

# Runtime
BRIDGE_TOTAL_TIMEOUT=3600
BRIDGE_IDLE_TIMEOUT=300
BRIDGE_UI_TIMEOUT=30
BRIDGE_UI_PROBE_TTL=60
BRIDGE_SHUTDOWN_GRACE_SECONDS=20
