# Copy to .env only if you need to override the Docker Compose defaults.
# These values are local-development placeholders, not production secrets.
POSTGRES_DB=cti_app
POSTGRES_USER=cti_app
POSTGRES_PASSWORD=local-postgres-only
MINIO_ROOT_USER=local-minio-user
MINIO_ROOT_PASSWORD=local-minio-password
S3_BUCKET=cti-local
SUBJECT_WORKSPACE_ROOT=work/subjects
LOG_LEVEL=INFO
JOB_RETRY_BASE_SECONDS=1
JOB_RETRY_MAX_SECONDS=300
JOB_HEARTBEAT_TIMEOUT_SECONDS=120
JOB_RECOVERY_INTERVAL_SECONDS=30

# Model gateways. Values are inert until a model-backed use case is explicitly invoked.
# Never commit real API keys. chatgpt-bridge is local HTTP but reaches ChatGPT externally.
# Compose services resolve the bridge by its service name. The host-only URL
# http://127.0.0.1:8001/v1 is reserved for clients running directly on the host.
OPENAI_BRIDGE_BASE_URL=http://chatgpt-bridge:8001/v1
OPENAI_BRIDGE_API_KEY=
BRIDGE_WS_TOKEN=
BRIDGE_UI_TIMEOUT_SECONDS=30
BRIDGE_SHUTDOWN_GRACE_SECONDS=20
OPENAI_BRIDGE_CONNECT_TIMEOUT_SECONDS=3
OPENAI_BRIDGE_CAPABILITIES_TIMEOUT_SECONDS=2
OPENAI_BRIDGE_MAX_ATTEMPTS=3
OPENAI_RESEARCH_MODEL=chatgpt-web
OPENAI_STRUCTURED_MODEL=chatgpt-web
OPENAI_DRAFTING_MODEL=chatgpt-web
OPENAI_CRITIC_MODEL=chatgpt-web

# Qwen belongs to the local trust boundary for this deployment, even when reached through
# the configured HTTPS gateway. Set QWEN_IS_EXTERNAL=true only if that trust decision changes.
QWEN_BASE_URL=https://llm-gateway.ai.chapsvision.com/llm-gateway
QWEN_API_KEY=
QWEN_MODEL=Qwen3-32B
QWEN_IS_EXTERNAL=false
MODEL_FORCE_ADAPTER=auto
MODEL_REQUEST_TIMEOUT_SECONDS=900

# Safe source collection. Limits apply to each explicit subject-collection job.
COLLECTION_MAX_REDIRECTS=5
COLLECTION_TIMEOUT_SECONDS=30
COLLECTION_MAX_DOWNLOAD_BYTES=10485760
COLLECTION_MAX_EXPANDED_BYTES=26214400
COLLECTION_MAX_DECOMPRESSION_RATIO=20
COLLECTION_ALLOWED_DOMAINS=
COLLECTION_BLOCKED_DOMAINS=
COLLECTION_FETCH_LEASE_SECONDS=120
PDF_MAX_DOCUMENT_BYTES=26214400
PDF_MAX_PAGES=200
PDF_PARSE_TIMEOUT_SECONDS=15
PDF_MAX_TEXT_CHARS=2000000
PDF_MAX_METADATA_LENGTH=16384
QWEN_CHUNK_MAX_CHARS=12000
QWEN_CHUNK_OVERLAP_CHARS=500

# Optional host-port overrides when another local application already uses a port.
BACKEND_PORT=8000
FRONTEND_PORT=5173
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
BRIDGE_PORT=8001
