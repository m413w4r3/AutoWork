# Copy to .env only if you need to override the Docker Compose defaults.
# These values are local-development placeholders, not production secrets.
APP_ENV=development
OPERATOR_API_TOKEN=
# Jeton distinct du jeton humain, reserve au client operateur (lecture/outils/redaction; jamais G2/G3).
OPERATOR_CLIENT_API_TOKEN=
POSTGRES_DB=cti_app
POSTGRES_USER=cti_app
POSTGRES_PASSWORD=local-postgres-only
MINIO_ROOT_USER=local-minio-user
MINIO_ROOT_PASSWORD=local-minio-password
S3_BUCKET=cti-local
SUBJECT_WORKSPACE_ROOT=work/subjects
LOG_LEVEL=INFO
JOB_RETRY_BASE_SECONDS=1
JOB_RETRY_MAX_SECONDS=300
JOB_BRIDGE_UI_RETRY_BASE_SECONDS=300
JOB_BRIDGE_UI_RETRY_MAX_SECONDS=1800
JOB_HEARTBEAT_TIMEOUT_SECONDS=120
DISCOVERY_BRIDGE_POLL_INTERVAL_SECONDS=5
JOB_RECOVERY_INTERVAL_SECONDS=30
# Durée max d'un job Dramatiq : le worker attend le fournisseur modèle, puis
# parse, persiste et regroupe.
JOB_ACTOR_TIME_LIMIT_SECONDS=4500
PRODUCTION_SUBJECT_JITTER_MIN_SECONDS=30
PRODUCTION_SUBJECT_JITTER_MAX_SECONDS=90
PRODUCTION_MODEL_JITTER_MIN_SECONDS=8
PRODUCTION_MODEL_JITTER_MAX_SECONDS=20
# Palier de repos long inséré tous les N sujets pour laisser le bridge ChatGPT
# récupérer. Mettre PRODUCTION_COOLDOWN_EVERY_N_SUBJECTS=0 pour le désactiver.
PRODUCTION_COOLDOWN_EVERY_N_SUBJECTS=3
PRODUCTION_COOLDOWN_MIN_SECONDS=600
PRODUCTION_COOLDOWN_MAX_SECONDS=1200
# Enable model-assisted relevance proposals; deterministic projection remains the baseline.
PRODUCTION_RELEVANCE_CLASSIFIER_ENABLED=true
# Enable bounded web search for missing editorial resources.
PRODUCTION_EDITORIAL_RESOURCE_SEARCH_ENABLED=false
# Fenêtre de réutilisation d'une extraction Q2 déjà réussie pour la même URL.
PRODUCTION_Q2_REUSE_MAX_AGE_DAYS=14
# En dessous de ce nombre de caractères, un texte archivé est une coquille
# anti-bot : aucun appel modèle n'est lancé dessus en archive fallback.
PRODUCTION_ARCHIVE_FALLBACK_MIN_CHARS=1200

# Model gateways. Values are inert until a model-backed use case is explicitly invoked.
# Never commit real API keys.
# ChatGPT Bridge is an external optional model provider.
# Set this URL to an address reachable from the AutoWork containers.
# Linux: a Bridge published on 127.0.0.1 is NOT reachable through
# host.docker.internal (connection refused). Publish it on the docker0 gateway
# (Bridge .env: BRIDGE_BIND_ADDRESS=172.17.0.1) or on 0.0.0.0 behind a
# firewall, and set a strong BRIDGE_API_KEY on the Bridge side.
OPENAI_BRIDGE_BASE_URL=http://host.docker.internal:8001/v1
# With the MetaHarness Bridges stack, compose.models.yaml overrides this with
# http://chatgpt-bridge:8001/v1 and WEBAI_BASE_URL with http://web_ai:6969/v1.
# HTTP Bearer key expected by the external Bridge.
OPENAI_BRIDGE_API_KEY=
OPENAI_BRIDGE_MIN_SUBMISSION_INTERVAL_SECONDS=20
OPENAI_BRIDGE_SUBMISSION_JITTER_FRACTION=0.3
OPERATOR_ADVISOR_CHECKPOINT_TOOL_THRESHOLD=12
OPENAI_BRIDGE_PRE_SUBMISSION_RETRY_BASE_SECONDS=1
OPENAI_BRIDGE_PRE_SUBMISSION_RETRY_MAX_SECONDS=8
MODEL_CONVERSATION_RETENTION_DAYS=90
OPENAI_BRIDGE_CONNECT_TIMEOUT_SECONDS=3
OPENAI_BRIDGE_CAPABILITIES_TIMEOUT_SECONDS=2
OPENAI_BRIDGE_ARCHIVE_TIMEOUT_SECONDS=60
OPENAI_RESEARCH_MODEL=chatgpt-web
OPENAI_STRUCTURED_MODEL=chatgpt-web
OPENAI_DRAFTING_MODEL=chatgpt-web
OPENAI_CRITIC_MODEL=chatgpt-web

# Qwen belongs to the local trust boundary for this deployment, even when reached through
# the configured HTTPS gateway. Set QWEN_IS_EXTERNAL=true only if that trust decision changes.
QWEN_BASE_URL=https://llm-gateway.ai.chapsvision.com/llm-gateway
QWEN_API_KEY=
QWEN_MODEL=Qwen3-32B
QWEN_IS_EXTERNAL=false

# Gemini via the local WebAI-to-API OpenAI-compatible gateway.
WEBAI_BASE_URL=http://web_ai:6969/v1
WEBAI_API_KEY=
WEBAI_MODEL=gemini-3-flash
WEBAI_IS_EXTERNAL=true

# Per-task backend routing. Defaults preserve the existing Bridge/Qwen split.
MODEL_ROUTE_WEB_RESEARCH=chatgpt_bridge
MODEL_ROUTE_BULK_EXTRACTION=chatgpt_bridge
MODEL_ROUTE_AMBIGUOUS_CLUSTERING=chatgpt_bridge
MODEL_ROUTE_STANDARD_DRAFT=chatgpt_bridge
MODEL_ROUTE_PREMIUM_SYNTHESIS=chatgpt_bridge
MODEL_ROUTE_EDITORIAL_ENRICHMENT=chatgpt_bridge
MODEL_ROUTE_CRITIQUE=chatgpt_bridge
MODEL_ROUTE_DISCOVERY_MERGE=chatgpt_bridge
MODEL_FORCE_ADAPTER=auto
MODEL_REQUEST_TIMEOUT_SECONDS=300
MODEL_REQUEST_TIMEOUT_RESEARCH_SECONDS=900
OPENAI_BRIDGE_WAIT_TIMEOUT_SECONDS=3600
OPENAI_BRIDGE_WAIT_TIMEOUT_RESEARCH_SECONDS=7200
MODEL_BACKGROUND_WAIT_TIMEOUT_SECONDS=5400
MODEL_BACKGROUND_IDLE_TIMEOUT_SECONDS=1200
# Optional research-role overrides; by default they inherit the global budgets.
# MODEL_BACKGROUND_WAIT_TIMEOUT_RESEARCH_SECONDS=5400
# MODEL_BACKGROUND_IDLE_TIMEOUT_RESEARCH_SECONDS=1200
DISCOVERY_CHATGPT_STRUCTURING_FALLBACK=false

# Safe source collection. Limits apply to each explicit subject-collection job.
COLLECTION_MAX_REDIRECTS=5
COLLECTION_TIMEOUT_SECONDS=30
COLLECTION_MAX_DOWNLOAD_BYTES=10485760
COLLECTION_MAX_EXPANDED_BYTES=26214400
COLLECTION_MAX_DECOMPRESSION_RATIO=20
COLLECTION_ALLOWED_DOMAINS=
COLLECTION_BLOCKED_DOMAINS=
COLLECTION_FETCH_LEASE_SECONDS=120
PDF_MAX_DOCUMENT_BYTES=26214400
PDF_MAX_PAGES=200
PDF_PARSE_TIMEOUT_SECONDS=15
PDF_MAX_TEXT_CHARS=2000000
PDF_MAX_METADATA_LENGTH=16384
QWEN_CHUNK_MAX_CHARS=12000
QWEN_CHUNK_OVERLAP_CHARS=500

# Optional host-port overrides when another local application already uses a port.
BACKEND_PORT=8000
FRONTEND_PORT=5173
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# PostgreSQL éphémère utilisé uniquement par `make test-integration`.
# Bind loopback uniquement ; indépendant de la DB applicative.
TEST_POSTGRES_PORT=55432

# Local diagnostic trail for the production pipeline.
# Leave empty to disable; local development only.
DIAGNOSTICS_LOG_ROOT=/var/diagnostics
# Optional VirusTotal v3 read-only transport. Proxy is the default and normally
# only transport; capabilities below authorize *operations*, not transports —
# routing (proxy/direct/legacy) is decided separately and deny-by-default.
VIRUSTOTAL_PROXY_URL=
# The proxy appends `&apikey=` verbatim; add `x=1` to queryless proxy-v3 calls.
VIRUSTOTAL_PROXY_QUERY_SENTINEL_ENABLED=true
VIRUSTOTAL_FILE_REPORT_ENABLED=false
VIRUSTOTAL_OBJECT_RELATIONSHIPS_ENABLED=false
VIRUSTOTAL_INTELLIGENCE_SEARCH_ENABLED=false
VIRUSTOTAL_BEHAVIOUR_REPORTS_ENABLED=false
VIRUSTOTAL_BEHAVIOUR_PCAP_ENABLED=false
VIRUSTOTAL_FILE_DOWNLOAD_ENABLED=false
VIRUSTOTAL_FILE_DOWNLOAD_LEGACY_FALLBACK_ENABLED=false
VIRUSTOTAL_RETROHUNT_ENABLED=false
VIRUSTOTAL_RETROHUNT_MAX_RESULT_PAGES=20
VIRUSTOTAL_RETROHUNT_MAX_RESULTS=1000
VIRUSTOTAL_BASE_URL=http://www.virustotal.com/api/v3
VIRUSTOTAL_FALLBACK_BASE_URL=https://www.virustotal.com/api/v3
VIRUSTOTAL_LEGACY_BASE_URL=http://www.virustotal.com/vtapi/v2
# Direct API key: only makes the direct transport available to be wired. It
# never authorizes an operation and never enables a route by itself — the two
# flags below must also be turned on explicitly for file_report's fallbacks.
VIRUSTOTAL_API_KEY=
VIRUSTOTAL_FILE_REPORT_PROXY_FALLBACK_ENABLED=false
VIRUSTOTAL_FILE_REPORT_LEGACY_FALLBACK_ENABLED=false
VIRUSTOTAL_PROXY_INSECURE=false
VIRUSTOTAL_CONNECT_TIMEOUT_SECONDS=5
VIRUSTOTAL_READ_TIMEOUT_SECONDS=60
VIRUSTOTAL_MAX_RESPONSE_BYTES=10485760
VIRUSTOTAL_DEFAULT_PAGE_SIZE=40
VIRUSTOTAL_MAX_PAGE_SIZE=100
VIRUSTOTAL_MAX_PAGES=10
VIRUSTOTAL_MAX_RESULTS=1000
VIRUSTOTAL_DOWNLOAD_MAX_BYTES=209715200
VIRUSTOTAL_DOWNLOAD_TIMEOUT_SECONDS=120
VIRUSTOTAL_DOWNLOAD_MAX_REDIRECTS=3
# Exact signed-download CDN host used by VT's v3 download redirect.
VIRUSTOTAL_DOWNLOAD_ALLOWED_HOSTS=vtsamples.commondatastorage.googleapis.com
VIRUSTOTAL_DOWNLOAD_ALLOWED_PORTS=443

# Passive Shodan reads only. No active scan operation is exposed.
SHODAN_API_KEY=
SHODAN_HOST_ENABLED=false
SHODAN_SEARCH_ENABLED=false
SHODAN_DOMAIN_ENABLED=false
SHODAN_COUNT_ENABLED=false
SHODAN_BASE_URL=https://api.shodan.io
SHODAN_CONNECT_TIMEOUT_SECONDS=5
SHODAN_READ_TIMEOUT_SECONDS=30
SHODAN_MAX_RESPONSE_BYTES=10485760
SHODAN_MAX_PAGES=10
SHODAN_MAX_RESULTS=1000

# Investigation-local analysis is closed by default. Local process tools become
# available only after the runtime bwrap probe measures filesystem confinement.
# Otherwise sample.analyze delegates to analysis-worker only when that separate
# service passes its isolation, health and pinned-version probe.
LOCAL_ANALYSIS_ENABLED=false
LOCAL_ANALYSIS_REQUIRE_FILESYSTEM_CONFINEMENT=true
LOCAL_ANALYSIS_TIMEOUT_SECONDS=30
LOCAL_ANALYSIS_MAX_OUTPUT_BYTES=1000000
LOCAL_ANALYSIS_CPU_LIMIT_SECONDS=30
LOCAL_ANALYSIS_MEMORY_LIMIT_BYTES=536870912
# CoreCLR virtual-address ceiling (8 GiB), not an RSS limit. The worker cgroup is 2 GiB;
# each .NET subprocess gets a 256 MiB GC heap hard limit.
DOTNET_ANALYSIS_ADDRESS_SPACE_LIMIT_BYTES=8589934592
LOCAL_ANALYSIS_FILE_SIZE_LIMIT_BYTES=1048576
LOCAL_ANALYSIS_MAX_SAMPLE_BYTES=209715200
ANALYSIS_WORKER_ENABLED=false
ANALYSIS_WORKER_PROBE_TIMEOUT_SECONDS=8
ANALYSIS_WORKER_JOB_TIMEOUT_SECONDS=120
ANALYSIS_WORKER_POLL_INTERVAL_SECONDS=0.25
ANALYSIS_WORKER_RESULT_MAX_BYTES=1000000
ANALYSIS_WORKER_EXPECTED_ISOLATION_PROFILE=bookworm-internal-v1
ANALYSIS_WORKER_ISOLATION_PROFILE=bookworm-internal-v1
ANALYSIS_LOCAL_FILE_EXPECTED_VERSION=5.44
ANALYSIS_LOCAL_BINUTILS_EXPECTED_VERSION=2.40
ANALYSIS_LOCAL_XXD_EXPECTED_VERSION=2022-01-14
ANALYSIS_LOCAL_COREUTILS_EXPECTED_VERSION=9.1
ANALYSIS_LOCAL_COMMAND_MAX_RANGE_BYTES=1048576
ANALYSIS_CAPA_EXPECTED_VERSION=9.4.0
ANALYSIS_SMDA_EXPECTED_VERSION=4.5.0
ANALYSIS_CAPA_RULESET_REVISION=2af9fbfc1c9b4634dbeb76b5d34fca9389fa7f80
ANALYSIS_TSHARK_EXPECTED_VERSION=4.0.17
ANALYSIS_CAPINFOS_EXPECTED_VERSION=4.0.17
ANALYSIS_SURICATA_EXPECTED_VERSION=7.0.10
ANALYSIS_SURICATA_RULESET_REVISION=autowork-suricata-v1
ANALYSIS_SURICATA_RULESET_SHA256=66f69f0cf586a87f739d4f63c6bb9d23a7d303f8adf23c2773a31839ea7f9f59
ANALYSIS_SURICATA_TIMEOUT_SECONDS=60
ANALYSIS_SURICATA_MAX_RULE_BYTES=65536
ANALYSIS_SURICATA_MAX_EVE_BYTES=16777216
ANALYSIS_SURICATA_MAX_EVENTS=24
ANALYSIS_STRING_MIN_LENGTH=4
ANALYSIS_MAX_STRINGS=10000
ANALYSIS_MAX_SAMPLE_BYTES=209715200
ANALYSIS_CAPA_TIMEOUT_SECONDS=60
ANALYSIS_CAPA_MAX_OUTPUT_BYTES=10485760
ANALYSIS_CAPA_MAX_MEMORY_BYTES=536870912
SMDA_TIMEOUT_SECONDS=120
SMDA_MAX_OUTPUT_BYTES=33554432
SMDA_MAX_MEMORY_BYTES=1073741824
RULE_WORKBENCH_ENABLED=true
MWCP_PARSER_VERSIONS={}

# Isolated, official Ghidra headless service. It stays disabled unless the
# optional ghidra Compose profile is started and its service attestation passes.
GHIDRA_ENABLED=false
GHIDRA_BASE_URL=http://ghidra:8787
GHIDRA_CONNECT_TIMEOUT_SECONDS=3
GHIDRA_READ_TIMEOUT_SECONDS=150
GHIDRA_MAX_SAMPLE_BYTES=209715200
GHIDRA_MAX_RESPONSE_BYTES=2097152
GHIDRA_EXPECTED_VERSION=12.1.4
GHIDRA_EXPECTED_JAVA_VERSION=21.0.12.1
GHIDRA_SERVICE_JOB_TIMEOUT_SECONDS=120

# Read-only native analysis provider. REA worker settings are non-secret identifiers.
NATIVE_ANALYSIS_ENABLED=false
NATIVE_ANALYSIS_PROVIDER=none
NATIVE_ANALYSIS_CATALOG_VERSION=autowork-native-read.v1
NATIVE_ANALYSIS_REA_EXPECTED_VERSION=
NATIVE_ANALYSIS_TIMEOUT_SECONDS=150
NATIVE_ANALYSIS_MAX_RESPONSE_BYTES=65536
NATIVE_ANALYSIS_MAX_OUTPUT_BYTES=32768

# Investigation limits. Zero means no allocation for that budget.
INVESTIGATION_MAX_CYCLES=12
INVESTIGATION_MAX_PIVOT_RUNS=0
INVESTIGATION_MAX_HITS_ACQUIRED=0
INVESTIGATION_MAX_NEW_SAMPLES=0
INVESTIGATION_MAX_VT_READ_UNITS=0
INVESTIGATION_MAX_SHODAN_CREDITS=0
INVESTIGATION_MAX_TOOL_SECONDS=3600
INVESTIGATION_MAX_CONTEXT_BYTES=4000000
INVESTIGATION_NO_PROGRESS_LIMIT=3
